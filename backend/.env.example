# 企业业务本体平台环境变量示例
# 复制本文件为 .env 后按需填写，切勿将真实 .env 提交到版本库

# ---- 依赖服务 ----
# JENA_BASE_URL=http://jena:3030
# JENA_DATASET=ontology
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=neo4jsecret
# POSTGRES_DSN=postgresql://ont:ontsecret@postgres:5432/ont

# ---- LLM（敏感信息） ----
# OpenAI 兼容接口的 base URL，例如 Ollama: http://localhost:11434/v1
# 保留 LLM_ENDPOINT 别名以兼容旧配置
LLM_BASE_URL=http://localhost:11434/v1
# LLM_ENDPOINT=http://localhost:11434/v1
LLM_MODEL=default
# API key：仅当服务端需要鉴权时填写
LLM_API_KEY=your-api-key-here
# 兼容旧命名
# OPENAI_API_KEY=your-api-key-here

# ---- 本地持久化 ----
# DATA_DIR=./data
# SECRETS_DIR=./secrets
# LOG_DIR=./logs
# LOG_LEVEL=INFO

# ---- 其他 ----
# MCP_TIMEOUT_SECONDS=10
# MCP_MAX_RETRIES=3
# CREDENTIAL_ENCRYPTION_ENABLED=false
