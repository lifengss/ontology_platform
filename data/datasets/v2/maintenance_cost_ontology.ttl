    rdfs:domain ont:obj_aftersales_labor_baseline,
        ont:obj_impl_labor_baseline,
        ont:obj_mgmt_cost_baseline,
        ont:obj_onsite_rate_baseline ;
    rdfs:range xsd:string .

ont:obj_machine_model a owl:Class ;
    rdfs:label "机型" ;
    rdfs:comment "服务产品列表中的服务器机型，含对外型号与 U 数规格。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_mgmt_cost_baseline a owl:Class ;
    rdfs:label "管理成本基线" ;
    rdfs:comment "单台管理成本基线，按客户、业务环节与境内外切分。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_onsite_rate_baseline a owl:Class ;
    rdfs:label "现场服务率基线" ;
    rdfs:comment "按产线、客户或产品细分、境内外切分的现场服务率，是人工/辅助/管理成本的共同乘数。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_part_failure_baseline a owl:Class ;
    rdfs:label "部件故障率基线" ;
    rdfs:comment "各部件在不同适用产品与客户细分下的故障率基线，用于推导备件直接成本。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_person_day_baseline a owl:Class ;
    rdfs:label "人天成本基线" ;
    rdfs:comment "服务商或自有人员在不同国家与产品线下的人天成本基线。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_region a owl:Class ;
    rdfs:label "区域" ;
    rdfs:comment "维保产品所属区域，取值来自成本核算主表的区域列。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_resident_cost_baseline a owl:Class ;
    rdfs:label "人员驻场成本基线" ;
    rdfs:comment "各产线、工程师等级与服务商区域组合下的工程师人月驻场成本。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_travel_cost_baseline a owl:Class ;
    rdfs:label "差旅成本基线" ;
    rdfs:comment "出差到不同国家/地区的单次机票与日均住宿、伙食、公杂费用标准。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_customer a owl:Class ;
    rdfs:label "客户" ;
    rdfs:comment "维保成本基线中的客户维度，取值来自各基线表的客户列。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_exchange_rate a owl:Class ;
    rdfs:label "汇率" ;
    rdfs:comment "外币对人民币的固定核算汇率，用于海外成本折算。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_material a owl:Class ;
    rdfs:label "物料/备件" ;
    rdfs:comment "备件成本表中的可替换部件，含物料编码、描述、单价与来源工厂。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_aftersales_labor_baseline a owl:Class ;
    rdfs:label "售后人工成本基线" ;
    rdfs:comment "单台售后人工成本基线，按 U 数档、客户、产品类别与响应级别切分。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_impl_labor_baseline a owl:Class ;
    rdfs:label "实施人工成本基线" ;
    rdfs:comment "单台实施人工成本基线，按实施类型或机型、客户、U 数档与境内外切分。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_sla_coefficient_baseline a owl:Class ;
    rdfs:label "服务水平系数基线" ;
    rdfs:comment "不同响应级别对应的服务水平系数，用于按 SLA 折算成本。" ;
    rdfs:subClassOf owl:Thing .

ont:obj_maintenance_product a owl:Class ;
    rdfs:label "维保服务产品" ;
    rdfs:comment "单台服务器原厂维保服务的成本核算结果，是区域与服务条款组合下的单台成本。" ;
    rdfs:subClassOf owl:Thing .

ont:attr_baseline_code a owl:DatatypeProperty ;
    rdfs:label "基线编码" ;
    rdfs:domain ont:obj_aftersales_labor_baseline,
        ont:obj_impl_labor_baseline,
        ont:obj_mgmt_cost_baseline,
        ont:obj_onsite_rate_baseline,
        ont:obj_part_failure_baseline,
        ont:obj_person_day_baseline,
        ont:obj_resident_cost_baseline,
        ont:obj_spare_aux_baseline ;
    rdfs:range xsd:string .

ont:obj_spare_aux_baseline a owl:Class ;
    rdfs:label "备件辅助成本基线" ;
    rdfs:comment "按地区与国家切分的备件辅助成本基线，覆盖仓储、配送、正逆向物流、ARMA 与税费。" ;
    rdfs:subClassOf owl:Thing .

