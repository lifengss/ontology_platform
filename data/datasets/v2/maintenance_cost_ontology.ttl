ont:obj_aftersales_labor_baseline_attr_baseline_codePS sh:datatype xsd:string ;
    sh:maxLength 64 ;
    sh:minCount 1 ;
    sh:minLength 4 ;
    sh:path ont:attr_baseline_code ;
    sh:pattern "^[A-Za-z0-9_\\-]+$" .

ont:obj_aftersales_labor_baseline_attr_baseline_valuePS sh:datatype xsd:float ;
    sh:minCount 1 ;
    sh:minInclusive 0e+00 ;
    sh:path ont:attr_baseline_value .

ont:obj_aftersales_labor_baseline_attr_customerPS sh:datatype xsd:string ;
    sh:in ( "阿里" "百度" "腾讯" "字节" "其他" ) ;
    sh:path ont:attr_customer .

ont:obj_aftersales_labor_baseline_attr_domesticPS sh:datatype xsd:string ;
    sh:in ( "国内" "海外" ) ;
    sh:minCount 1 ;
    sh:path ont:attr_domestic .

ont:obj_aftersales_labor_baseline_attr_product_categoryPS sh:datatype xsd:string ;
    sh:in ( "通用服务器" "AI服务器-PCIE卡" "AI服务器-模组" "白盒交换机" "STR" ) ;
    sh:minCount 1 ;
    sh:path ont:attr_product_category .

ont:obj_aftersales_labor_baseline_attr_regionPS sh:datatype xsd:string ;
    sh:maxLength 64 ;
    sh:path ont:attr_region .

ont:obj_aftersales_labor_baseline_attr_response_levelPS sh:datatype xsd:string ;
    sh:in ( "NBD" "ND" "4H" "2H" ) ;
