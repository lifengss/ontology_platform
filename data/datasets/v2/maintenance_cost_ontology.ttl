ont:obj_aftersales_labor_baselineShape a sh:NodeShape ;
    sh:property ont:obj_aftersales_labor_baseline_attr_baseline_codePS,
        ont:obj_aftersales_labor_baseline_attr_baseline_valuePS,
        ont:obj_aftersales_labor_baseline_attr_customerPS,
        ont:obj_aftersales_labor_baseline_attr_domesticPS,
        ont:obj_aftersales_labor_baseline_attr_product_categoryPS,
        ont:obj_aftersales_labor_baseline_attr_regionPS,
        ont:obj_aftersales_labor_baseline_attr_response_levelPS,
        ont:obj_aftersales_labor_baseline_attr_u_bandPS ;
    sh:targetClass ont:obj_aftersales_labor_baseline ;
    sh:uniqueKey ( ont:attr_baseline_code ) .

ont:obj_customerShape a sh:NodeShape ;
